# Environment configuration for Connect

# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="connect-development-secret-key-32-characters-long"

# Google OAuth (Optional for local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Integration
GEMINI_API_KEY=""

# Security (AES-256-GCM 32-byte hex string)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# External Providers (seed | live)
PROVIDER_SKILLS="seed"
PROVIDER_JOBS="seed"
PROVIDER_GOV="seed"
PROVIDER_SCHOLARSHIPS="seed"
